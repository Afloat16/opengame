[1,0,0,[["cc.JsonAsset",["_name","json"],1]],[[0,0,1,3]],[[0,"story11",{"title":"大结局","bg":"bg_story_03","context":[{"pos":2,"text":"时间穿越回了现代，带着呼吸机的张鹏在医院里醒来，他拔掉了身上的医疗设备，情绪激动的寻找起了齐晟。"},{"pos":2,"text":"当他赤着脚去找医生打听的时候，发现那个医生正是齐晟。"},{"pos":0,"name":"你","image":"role_taizi","text":"你......"},{"pos":1,"name":"医生","image":"role_taizi","text":"（凝视）......"},{"pos":2,"text":"两人四目相对，齐晟望着张鹏脑海中回想起了张芃芃的音容笑貌。"}]}]],0,0,[],[],[]]
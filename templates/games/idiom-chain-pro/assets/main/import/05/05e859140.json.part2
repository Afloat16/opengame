e;\n  #endif\n  in vec4 v_color;\n  uniform Constant {\n  float DissCon;\n  float NoiseInt;\n};\n  vec4 c_TextureToRGBA_main_11(vec2 UV, sampler2D Texture) {\n    return texture2D(Texture, UV);\n}\nvec2 c_NoiseVoronoi_f_voronoi_noise_random_vector_18 (vec2 UV, float offset) {\n    mat2 m = mat2(15.27, 47.63, 99.41, 89.98);\n    vec2 c = UV * m;\n    UV.x = fract(sin(c.x) * 46839.32);\n    UV.y = fract(sin(c.y) * 46839.32);\n    return vec2(sin(UV.y * offset) * 0.5 + 0.5, cos(UV.x * offset) * 0.5 + 0.5);\n}\nfloat c_NoiseVoronoi_main_18(vec2 uv, float AngleOffset, float CellDensity) {\n   float Out = 0.0;\n   vec2 g = floor(uv * CellDensity);\n   vec2 f = fract(uv * CellDensity);\n   float t = 8.0;\n   vec3 res = vec3(8.0, 0.0, 0.0);\n   for(int y = -1; y <= 1; y ++)\n   {\n       for(int x =- 1; x <= 1; x ++)\n       {\n           vec2 lattice = vec2(x, y);\n           vec2 offset = c_NoiseVoronoi_f_voronoi_noise_random_vector_18(lattice + g, AngleOffset);\n           float d = distance(lattice + offset, f);\n           if(d < res.x)\n           {\n               res = vec3(d, offset.x, offset.y);\n               Out = res.x;\n           }\n       }\n   }\n   return Out;\n}\nfloat c_Add1_main_13(float InputA, float InputB) {\n    return (InputA + InputB);\n}\nfloat c_Mul1_main_15(float InputA, float InputB) {\n    return (InputA * InputB);\n}\nvec4 c_31To4_main_12(vec3 InputA, float InputB) {\n    return vec4(InputA, InputB);\n}\nvec4 c_Output_main_1(vec4 Color) {\n    return Color;\n}\nvoid main()\n{\n    vec4 out_Color_TextureToRGBA_11 = c_TextureToRGBA_main_11(v_uv0, texture);\n    float out_a_TextureToRGBA_11 = out_Color_TextureToRGBA_11.a;\n    vec3 out_rgb_TextureToRGBA_11 = out_Color_TextureToRGBA_11.rgb;\n    float out_Output_NoiseVoronoi_18 = c_NoiseVoronoi_main_18(v_uv0, DissCon, NoiseInt);\n    float out_Output_Add1_13 = c_Add1_main_13(DissCon, out_Output_NoiseVoronoi_18);\n    float out_Output_Mul1_15 = c_Mul1_main_15(out_a_TextureToRGBA_11, out_Output_Add1_13);\n    vec4 out_Output_31To4_12 = c_31To4_main_12(vec3(out_rgb_TextureToRGBA_11), out_Output_Mul1_15);\n    gl_FragColor = c_Output_main_1(vec4(out_Output_31To4_12));\n}"},"glsl1":{"vert":"\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\n#if USE_TEXTURE\n    attribute vec2 a_uv0;\n    varying vec2 v_uv0;\n#endif\nattribute vec4 a_color;\nvarying vec4 v_color;\nvoid main () {\n    mat4 mvp;\n    #if CC_USE_MODEL\n        mvp = cc_matViewProj * cc_matWorld;\n    #else\n        mvp = cc_matViewProj;\n    #endif\n    #if USE_TEXTURE\n        v_uv0 = a_uv0;\n    #endif\n    #if USE_TINT\n    #endif\n    v_color = a_color;\n    gl_Position = mvp * vec4(a_position, 1);\n}","frag":"\n  precision highp float;\n  #if USE_TEXTURE\n      varying vec2 v_uv0;\n      uniform sampler2D texture;\n  #endif\n  varying vec4 v_color;\n  uniform float DissCon;\nuniform float NoiseInt;\n  vec4 c_TextureToRGBA_main_11(vec2 UV, sampler2D Texture) {\n    return texture2D(Texture, UV);\n}\nvec2 c_NoiseVoronoi_f_voronoi_noise_random_vector_18 (vec2 UV, float offset) {\n    mat2 m = mat2(15.27, 47.63, 99.41, 89.98);\n    vec2 c = UV * m;\n    UV.x = fract(sin(c.x) * 46839.32);\n    UV.y = fract(sin(c.y) * 46839.32);\n    return vec2(sin(UV.y * offset) * 0.5 + 0.5, cos(UV.x * offset) * 0.5 + 0.5);\n}\nfloat c_NoiseVoronoi_main_18(vec2 uv, float AngleOffset, float CellDensity) {\n   float Out = 0.0;\n   vec2 g = floor(uv * CellDensity);\n   vec2 f = fract(uv * CellDensity);\n   float t = 8.0;\n   vec3 res = vec3(8.0, 0.0, 0.0);\n   for(int y = -1; y <= 1; y ++)\n   {\n       for(int x =- 1; x <= 1; x ++)\n       {\n           vec2 lattice = vec2(x, y);\n           vec2 offset = c_NoiseVoronoi_f_voronoi_noise_random_vector_18(lattice + g, AngleOffset);\n           float d = distance(lattice + offset, f);\n           if(d < res.x)\n           {\n               res = vec3(d, offset.x, offset.y);\n               Out = res.x;\n      